APP_NAME="VaaniAI Backend"
DATABASE_URL="sqlite:///./vaaniai.db"
PUBLIC_BASE_URL="http://127.0.0.1:8000"
DEMO_MODE=true

# STT providers: stub | faster_whisper | groq | elevenlabs | cartesia
STT_PROVIDER="stub"
STT_MODEL_SIZE="small"
STT_DEVICE="cpu"
STT_COMPUTE_TYPE="int8"
# Optional: set to "hi" or "en"; leave empty for auto-detect.
STT_LANGUAGE=
GROQ_API_KEY=
GROQ_STT_MODEL="whisper-large-v3-turbo"

# ElevenLabs audio provider for STT, TTS, and optional speech-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_FALLBACK_VOICE_ID=
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"
ELEVENLABS_STS_MODEL="eleven_multilingual_sts_v2"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"

# Cartesia audio provider for STT and TTS.
CARTESIA_API_KEY=
CARTESIA_VERSION="2026-03-01"
CARTESIA_STT_MODEL="ink-whisper"
CARTESIA_TTS_MODEL="sonic-3.5"
CARTESIA_VOICE_ID=
CARTESIA_OUTPUT_CONTAINER="mp3"
CARTESIA_SAMPLE_RATE=44100
CARTESIA_BIT_RATE=128000
CARTESIA_SPEED=1.0
CARTESIA_VOLUME=1.0

# TTS providers: stub | xtts | elevenlabs | cartesia
# TTS_SPEAKER_WAV must point to a short clean WAV voice sample.
TTS_PROVIDER="stub"
TTS_MODEL_NAME="tts_models/multilingual/multi-dataset/xtts_v2"
TTS_SPEAKER_WAV=
GENERATED_AUDIO_DIR="generated_audio"

# LLM providers: stub | openrouter
LLM_PROVIDER="stub"
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openai/gpt-oss-120b"
OPENROUTER_TEMPERATURE=0.35
VOICE_AGENT_POLISH_REPLIES=false

# Legacy LLM placeholder
GEMINI_API_KEY=

# Future phone-call phase: required only when Vapi webhook/calling is enabled.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# Optional booking confirmation SMS.
SMS_PROVIDER="stub"
CLINIC_NAME="Pawani Medicals"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE="q"
FAST2SMS_LANGUAGE="english"
FAST2SMS_SENDER_ID=

# Optional Google Calendar sync. Keep credential JSON outside git.
CALENDAR_PROVIDER="disabled"
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
